#. TRANSLATORS: Error message shown when another app instance's IPC pipe already exists and a new one can't be created
msgid "Failed to create IPC server"
msgstr "IPCサーバーを作成できません"

#. TRANSLATORS: Title of a warning dialog
msgid "Warning"
msgstr "警告"

#. TRANSLATORS: Description/tagline of the application shown in the About dialog
msgid "An accessible, lightweight, fast ebook and document reader"
msgstr "アクセシブル、軽量、高速な電子書籍・文書リーダー"

#. TRANSLATORS: Title of the All Documents dialog
msgid "All Documents"
msgstr "すべての文書"

#. TRANSLATORS: Label for the search input field in the All Documents dialog
msgid "&search"
msgstr "検索(&S)"

#. TRANSLATORS: Label for the confirmation dialog "Yes" button
msgid "&Yes"
msgstr "はい(&Y)"

#. TRANSLATORS: Label for the confirmation dialog "No" button
msgid "&No"
msgstr "いいえ(&N)"

#. TRANSLATORS: Column header for the document filename in the All Documents list
msgid "File Name"
msgstr "ファイル名"

#. TRANSLATORS: Column header for the document status (e.g. Open, Closed, Missing) in the All Documents list
msgid "Status"
msgstr "状態"

#. TRANSLATORS: Column header for the file path in the All Documents list
msgid "Path"
msgstr "パス"

#. TRANSLATORS: Label for the status filter dropdown in the All Documents dialog
msgid "&Status:"
msgstr "状態(&S):"

#. TRANSLATORS: Option in the All Documents status filter to show documents of every status
#. TRANSLATORS: Option in the filter dropdown to show all entries
msgid "All"
msgstr "すべて"

#. TRANSLATORS: Status of a document that is currently open in a tab
msgid "Open"
msgstr "オープン"

#. TRANSLATORS: Status of a document that was previously opened but is currently closed
msgid "Closed"
msgstr "クローズ"

#. TRANSLATORS: Status of a document whose file could not be found on disk
msgid "Missing"
msgstr "見つかりません"

#. TRANSLATORS: Button label to open the selected document
msgid "&Open"
msgstr "開く(&O)"

#. TRANSLATORS: Button label to locate a missing file on disk
msgid "&Locate…"
msgstr "場所を指定(&L)…"

#. TRANSLATORS: Button label to remove selected documents from the list
msgid "&Remove"
msgstr "削除(&R)"

#. TRANSLATORS: Button label to clear all documents from the list
msgid "&Clear All"
msgstr "すべて削除(&C)"

#. TRANSLATORS: Label for a button that closes a dialog
msgid "Close"
msgstr "閉じる"

msgid "Are you sure you want to remove the selected document? This will also remove its reading position and bookmarks."
msgstr "選択した文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

msgid "Are you sure you want to remove the {} selected documents? This will also remove their reading positions and bookmarks."
msgstr "{}件の文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

#. TRANSLATORS: Title of the confirmation dialog
msgid "Confirm"
msgstr "確認"

#. TRANSLATORS: Confirmation prompt when clearing all documents from the list.
msgid "Are you sure you want to remove all documents from the list? This will also remove all reading positions and bookmarks."
msgstr "すべての文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

#. TRANSLATORS: Status bar text in the All Documents dialog when the list is empty
msgid "No documents."
msgstr "文書なし。"

#. TRANSLATORS: Status bar text in the All Documents dialog when the list contains exactly one document and none are selected
msgid "1 document."
msgstr "1件の文書。"

#. TRANSLATORS: Status bar text in the All Documents dialog showing the total number of documents in the list. The %d placeholder is replaced with the count.
msgid "%d documents."
msgstr "%d件の文書。"

#. TRANSLATORS: Status bar text in the All Documents dialog when the single document in the list is selected
msgid "1 of 1 document selected."
msgstr "1 / 1件を選択。"

#. TRANSLATORS: Status bar text in the All Documents dialog when every document in the list is selected. The %d placeholder is replaced with the total count.
msgid "All %d documents selected."
msgstr "%d件すべてを選択。"

#. TRANSLATORS: Status bar text in the All Documents dialog showing how many of the total documents are selected. The first %d is the selected count, the second %d is the total count.
msgid "%d of %d documents selected."
msgstr "%d / %d件を選択。"

#. TRANSLATORS: Message/prompt shown in the file picker dialog to locate a missing book
msgid "Locate Book"
msgstr "文書の場所を指定"

#. TRANSLATORS: Title of the Jump to Bookmark dialog
msgid "Jump to Bookmark"
msgstr "しおりへ移動"

#. TRANSLATORS: Label for the bookmark filter dropdown
msgid "&Filter:"
msgstr "フィルター(&F):"

#. TRANSLATORS: Option in the filter dropdown to show bookmarks only
msgid "Bookmarks"
msgstr "しおり"

#. TRANSLATORS: Option in the filter dropdown to show notes only
msgid "Notes"
msgstr "メモ"

#. TRANSLATORS: Label for the bookmark/note list (used only as an accessibility label on macOS)
msgid "&Bookmarks:"
msgstr "しおり(&B):"

#. TRANSLATORS: Label for the button to edit a note
msgid "&Edit Note"
msgstr "メモの編集(&E)"

msgid "&Delete"
msgstr "削除(&D)"

#. TRANSLATORS: Label for the button to jump to the selected bookmark
msgid "&Jump"
msgstr "移動(&J)"

#. TRANSLATORS: Label for the button to cancel the action
msgid "&Cancel"
msgstr "キャンセル(&C)"

#. TRANSLATORS: Placeholder text shown in the bookmarks list when the bookmark text range is empty or blank
msgid "blank"
msgstr "空白"

#. TRANSLATORS: Error message shown when the user attempts to jump without selecting any bookmark
msgid "Please select a bookmark to jump to."
msgstr "移動先のしおりを選択してください。"

#. TRANSLATORS: Generic error dialog title
msgid "Error"
msgstr "エラー"

#. TRANSLATORS: Title of the Bookmark Note editor dialog
msgid "Bookmark Note"
msgstr "しおりのメモ"

#. TRANSLATORS: Label/prompt in the Note editor dialog
msgid "Edit bookmark note:"
msgstr "しおりのメモを編集:"

#. TRANSLATORS: Title of the Document Info dialog
msgid "Document Info"
msgstr "文書情報"

#. TRANSLATORS: Label for the document's file path
msgid "Path:"
msgstr "パス:"

#. TRANSLATORS: Label for the document's title
msgid "Title:"
msgstr "タイトル:"

#. TRANSLATORS: Label for the document's author
msgid "Author:"
msgstr "著者:"

#. TRANSLATORS: Label for the number of words in the document
msgid "Words:"
msgstr "単語数:"

#. TRANSLATORS: Label for the number of lines in the document
msgid "Lines:"
msgstr "行数:"

#. TRANSLATORS: Label for the number of characters in the document
msgid "Characters:"
msgstr "文字数:"

#. TRANSLATORS: Label for the number of characters in the document excluding space characters
msgid "Characters (excluding spaces):"
msgstr "文字数（スペースを除く）:"

#. TRANSLATORS: Title of the Elements dialog
msgid "Elements"
msgstr "要素"

#. TRANSLATORS: Label for the view selection dropdown in the Elements dialog
msgid "&View:"
msgstr "表示(&V):"

#. TRANSLATORS: Choice option in the view dropdown to show headings list
msgid "Headings"
msgstr "見出し"

#. TRANSLATORS: Choice option in the view dropdown to show links list
msgid "Links"
msgstr "リンク"

#. TRANSLATORS: Placeholder text shown in the elements list when a document element has no text content
msgid "Untitled"
msgstr "無題"

#. TRANSLATORS: Label for the confirmation button
msgid "OK"
msgstr "OK"

#. TRANSLATORS: Title of the Go to Line dialog
msgid "Go to Line"
msgstr "指定行へ移動"

#. TRANSLATORS: Label for the input field where users enter the target line number.
msgid "&Line number:"
msgstr "行番号(&L):"

#. TRANSLATORS: Label for the button that jumps to the entered position (a line, page, or percentage, depending on the dialog)
msgid "Go"
msgstr "移動"

#. TRANSLATORS: Title of the Go to page dialog
msgid "Go to page"
msgstr "指定ページへ移動"

#. TRANSLATORS: Label/prompt template for the page selection dialog. The %d placeholders represent current_page and max_pages respectively.
msgid "Go to page (%d/%d):"
msgstr "ページ数（%d/%d）:"

#. TRANSLATORS: Title of the Go to Percent dialog
msgid "Go to Percent"
msgstr "パーセント移動"

#. TRANSLATORS: Label for the percentage selection slider
msgid "&Percent"
msgstr "パーセント(&P)"

#. TRANSLATORS: Label for the numeric percentage entry field
msgid "P&ercent:"
msgstr "パーセント(&E):"

#. TRANSLATORS: Title of the Open As dialog
msgid "Open As"
msgstr "読み込み形式の指定"

#. TRANSLATORS: Prompt template informing the user that no parser was found for their file. The {} placeholder is replaced with the file path.
msgid ""
"No suitable parser was found for {}.\n"
"How would you like to open this file?"
msgstr ""
"{}に対応するパーサーが見つかりませんでした。\n"
"このファイルをどのように開きますか？"

#. TRANSLATORS: Label for the format selection dropdown
msgid "Open &as:"
msgstr "読み込み形式(&A):"

#. TRANSLATORS: Choice option to open a file as plain text
msgid "Plain Text"
msgstr "プレーンテキスト"

#. TRANSLATORS: Choice option to open a file as HTML
msgid "HTML"
msgstr "HTML"

#. TRANSLATORS: Choice option to open a file as Markdown
msgid "Markdown"
msgstr "Markdown"

#. TRANSLATORS: Title of the Options dialog
msgid "Options"
msgstr "オプション"

#. TRANSLATORS: Option to restore documents that were open when the app was last closed
msgid "&Restore previously opened documents on startup"
msgstr "起動時に前回の文書を開く(&R)"

#. TRANSLATORS: Option to toggle word wrapping of text
msgid "&Word wrap"
msgstr "ワードラップ(&W)"

#. TRANSLATORS: Option to render tables inline rather than showing a placeholder link
msgid "Render tables &inline"
msgstr "テーブルをインライン表示(&I)"

#. TRANSLATORS: Option to minimize the app window to the system tray instead of the taskbar
msgid "&Minimize to system tray"
msgstr "システムトレーに最小化(&M)"

#. TRANSLATORS: Option to start the app maximized
msgid "&Start maximized"
msgstr "最大化して起動(&S)"

#. TRANSLATORS: Option to show a compact Go navigation menu in the menu bar
msgid "Show compact &go menu"
msgstr "[移動]メニューをコンパクト表示(&G)"

#. TRANSLATORS: Option to wrap navigation around to the beginning/end when navigating elements
msgid "&Wrap navigation"
msgstr "ナビゲーションの折り返し(&W)"

#. TRANSLATORS: Option to move the caret to the start of the line when navigating up or down
msgid "Move to &start of line"
msgstr "上下移動時に行頭へ移動(&S)"

#. TRANSLATORS: Option to play sound effects when bookmarks or notes are encountered
msgid "Play &sounds on bookmarks and notes"
msgstr "しおりとメモでサウンドを再生(&S)"

#. TRANSLATORS: Option to move the reading caret to follow along with audio narration as it plays
msgid "&Sync caret to audio playback"
msgstr "キャレットを音声再生に同期(&S)"

#. TRANSLATORS: Label for the audio seek amount dropdown, used when skipping audio narration backward/forward
msgid "&Audio seek amount:"
msgstr "音声の移動量(&A):"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "5 seconds"
msgstr "5秒"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "10 seconds"
msgstr "10秒"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "30 seconds"
msgstr "30秒"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Singular label for 1 minute duration
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "1 minute"
msgstr "1分"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "2 minutes"
msgstr "2分"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "5 minutes"
msgstr "5分"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "10 minutes"
msgstr "10分"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "30 minutes"
msgstr "30分"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Singular label for 1 hour duration
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "1 hour"
msgstr "1時間"

#. TRANSLATORS: Option controlling whether seeking audio narration past the end of a chapter's file continues into the next chapter, or stops at the end of the current one
msgid "Seeking &past the end of a chapter continues into the next"
msgstr "章をまたいで音声を移動する(&P)"

#. TRANSLATORS: Option to check for app updates automatically on startup
msgid "Check for &updates on startup"
msgstr "起動時に更新を確認(&U)"

#. TRANSLATORS: Option to automatically reload an open document when its file changes on disk
msgid "&Automatically reload changed documents"
msgstr "変更された文書を自動的に再読み込み(&A)"

#. TRANSLATORS: Button label to open the hotkey customization dialog
msgid "Customize &Window Hotkey..."
msgstr "ウィンドウを開くホットキーの変更(&W)..."

msgid "Customize &Keyboard Shortcuts..."
msgstr "キーボードショートカットのカスタマイズ(&K)..."

#. TRANSLATORS: Label for the reading speed input field (Words Per Minute)
msgid "&Reading speed (words per minute):"
msgstr "閲覧速度（単語/分）(&R):"

#. TRANSLATORS: Label for the number of recently opened documents to keep in history
msgid "Number of &recent documents to show:"
msgstr "最近開いた文書の表示件数(&R):"

#. TRANSLATORS: Label for the language selection dropdown
msgid "&Language:"
msgstr "言語(&L):"

#. TRANSLATORS: Label for the update channel selection dropdown
msgid "Update Channel:"
msgstr "更新チャンネル:"

#. TRANSLATORS: Stable update channel option
msgid "Stable"
msgstr "安定版"

#. TRANSLATORS: Developer/development update channel option
msgid "Dev"
msgstr "開発版"

#. TRANSLATORS: Label/header for the Font options section
msgid "Font"
msgstr "フォント"

#. TRANSLATORS: Button label to pick a font
msgid "Choose &Font..."
msgstr "フォントの選択(&F)..."

#. TRANSLATORS: Button label to restore font settings to default values
msgid "&Reset to Default Font"
msgstr "既定のフォントに戻す(&R)"

#. TRANSLATORS: Label/header for the Background Color options section
msgid "Background Color"
msgstr "背景色"

#. TRANSLATORS: Button label to pick a background color
msgid "Choose &Background Color..."
msgstr "背景色の変更(&B)..."

#. TRANSLATORS: Button label to restore background color to default values
msgid "Reset to &Default Background"
msgstr "既定の背景色に戻す(&D)"

#. TRANSLATORS: Label for the line spacing dropdown
msgid "&Line spacing:"
msgstr "行の間隔(&L):"

#. TRANSLATORS: Default spacing option (as opposed to relaxed/wide), shown in the line, paragraph, and letter spacing dropdowns
msgid "Normal"
msgstr "標準"

