msgid "1.5\\u{00d7}"
msgstr "1.5倍"

#. TRANSLATORS: Double line spacing option
msgid "Double"
msgstr "2倍"

#. TRANSLATORS: Label for the paragraph spacing dropdown
msgid "&Paragraph spacing:"
msgstr "段落の間隔(&P):"

