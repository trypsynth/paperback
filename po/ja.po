msgstr "キーボードショートカットのカスタマイズ"

msgid "&Shortcuts:"
msgstr "ショートカット(&S):"

msgid "&Set Shortcut..."
msgstr "ショートカットを設定(&S)..."

msgid "&Clear Shortcut"
msgstr "ショートカットを解除(&C)"

msgid "&Reset to Default"
msgstr "既定に戻す(&R)"

msgid "Reset &All to Defaults"
msgstr "すべて既定に戻す(&A)"

msgid "Shortcut Conflict"
msgstr "ショートカットの重複"

