#. TRANSLATORS: Error message shown when another app instance's IPC pipe already exists and a new one can't be created
msgid "Failed to create IPC server"
msgstr "IPCサーバーの作成に失敗しました"

#. TRANSLATORS: Title of a warning dialog
msgid "Warning"
msgstr "警告"

#. TRANSLATORS: Description/tagline of the application shown in the About dialog
msgid "An accessible, lightweight, fast ebook and document reader"
msgstr "アクセシブル、軽量、高速な電子書籍・文書リーダー"

#. TRANSLATORS: Title of the All Documents dialog
msgid "All Documents"
msgstr "すべての文書"

#. TRANSLATORS: Label for the search input field in the All Documents dialog
msgid "&search"
msgstr "検索(&S)"

#. TRANSLATORS: Label for the confirmation dialog "Yes" button
msgid "&Yes"
msgstr "はい(&Y)"

#. TRANSLATORS: Label for the confirmation dialog "No" button
msgid "&No"
msgstr "いいえ(&N)"

#. TRANSLATORS: Column header for the document filename in the All Documents list
msgid "File Name"
msgstr "ファイル名"

#. TRANSLATORS: Column header for the document status (e.g. Open, Closed, Missing) in the All Documents list
msgid "Status"
msgstr "状態"

#. TRANSLATORS: Column header for the file path in the All Documents list
msgid "Path"
msgstr "パス"

#. TRANSLATORS: Button label to open the selected document
msgid "&Open"
msgstr "開く(&O)"

#. TRANSLATORS: Button label to locate a missing file on disk
msgid "&Locate…"
msgstr "場所を指定(&L)…"

#. TRANSLATORS: Button label to remove selected documents from the list
msgid "&Remove"
msgstr "削除(&R)"

#. TRANSLATORS: Button label to clear all documents from the list
msgid "&Clear All"
msgstr "すべて削除(&C)"

#. TRANSLATORS: Label for a button that closes a dialog
msgid "Close"
msgstr "閉じる"

msgid "Are you sure you want to remove the selected document? This will also remove its reading position and bookmarks."
msgstr "選択した文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

msgid "Are you sure you want to remove the {} selected documents? This will also remove their reading positions and bookmarks."
msgstr "{}件の文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

#. TRANSLATORS: Title of the confirmation dialog
msgid "Confirm"
msgstr "確認"

#. TRANSLATORS: Confirmation prompt when clearing all documents from the list.
msgid "Are you sure you want to remove all documents from the list? This will also remove all reading positions and bookmarks."
msgstr "すべての文書を削除しますか？これにより、読み上げ位置としおりも削除されます。"

#. TRANSLATORS: Status of a document that is currently open in a tab
msgid "Open"
msgstr "オープン"

#. TRANSLATORS: Status of a document that was previously opened but is currently closed
msgid "Closed"
msgstr "クローズ"

#. TRANSLATORS: Status of a document whose file could not be found on disk
msgid "Missing"
msgstr "見つかりません"

#. TRANSLATORS: Message/prompt shown in the file picker dialog to locate a missing book
msgid "Locate Book"
msgstr "文書の場所を指定"

#. TRANSLATORS: Title of the Jump to Bookmark dialog
msgid "Jump to Bookmark"
msgstr "しおりへ移動"

#. TRANSLATORS: Label for the bookmark filter dropdown
msgid "&Filter:"
msgstr "フィルター(&F):"

#. TRANSLATORS: Option in the filter dropdown to show all entries
msgid "All"
msgstr "すべて"

#. TRANSLATORS: Option in the filter dropdown to show bookmarks only
msgid "Bookmarks"
msgstr "しおり"

#. TRANSLATORS: Option in the filter dropdown to show notes only
msgid "Notes"
msgstr "メモ"

#. TRANSLATORS: Label for the bookmark/note list (used only as an accessibility label on macOS)
msgid "&Bookmarks:"
msgstr "しおり(&B):"

#. TRANSLATORS: Label for the button to edit a note
msgid "&Edit Note"
msgstr "メモの編集(&E)"

#. TRANSLATORS: Standard "Delete" edit menu item label
msgid "&Delete"
msgstr "削除(&D)"

#. TRANSLATORS: Label for the button to jump to the selected bookmark
msgid "&Jump"
msgstr "移動(&J)"

#. TRANSLATORS: Label for the button to cancel the action
msgid "&Cancel"
msgstr "キャンセル(&C)"

#. TRANSLATORS: Placeholder text shown in the bookmarks list when the bookmark text range is empty or blank
msgid "blank"
msgstr "空白"

#. TRANSLATORS: Error message shown when the user attempts to jump without selecting any bookmark
msgid "Please select a bookmark to jump to."
msgstr "移動先のしおりを選択してください。"

#. TRANSLATORS: Generic error dialog title
msgid "Error"
msgstr "エラー"

#. TRANSLATORS: Title of the Bookmark Note editor dialog
msgid "Bookmark Note"
msgstr "しおりのメモ"

#. TRANSLATORS: Label/prompt in the Note editor dialog
msgid "Edit bookmark note:"
msgstr "しおりのメモを編集:"

#. TRANSLATORS: Title of the Document Info dialog
msgid "Document Info"
msgstr "文書情報"

#. TRANSLATORS: Label for the document's file path
msgid "Path:"
msgstr "パス:"

#. TRANSLATORS: Label for the document's title
msgid "Title:"
msgstr "タイトル:"

#. TRANSLATORS: Label for the document's author
msgid "Author:"
msgstr "著者:"

#. TRANSLATORS: Label for the number of words in the document
msgid "Words:"
msgstr "単語数:"

#. TRANSLATORS: Label for the number of lines in the document
msgid "Lines:"
msgstr "行数:"

#. TRANSLATORS: Label for the number of characters in the document
msgid "Characters:"
msgstr "文字数:"

#. TRANSLATORS: Label for the number of characters in the document excluding space characters
msgid "Characters (excluding spaces):"
msgstr "文字数(スペースを除く):"

#. TRANSLATORS: Title of the Elements dialog
msgid "Elements"
msgstr "要素"

#. TRANSLATORS: Label for the view selection dropdown in the Elements dialog
msgid "&View:"
msgstr "表示(&V):"

#. TRANSLATORS: Choice option in the view dropdown to show headings list
msgid "Headings"
msgstr "見出し"

#. TRANSLATORS: Choice option in the view dropdown to show links list
msgid "Links"
msgstr "リンク"

#. TRANSLATORS: Placeholder text shown in the elements list when a document element has no text content
msgid "Untitled"
msgstr "無題"

#. TRANSLATORS: Label for the confirmation button
msgid "OK"
msgstr "OK"

#. TRANSLATORS: Label for the cancellation button
msgid "Cancel"
msgstr "キャンセル"

#. TRANSLATORS: Title of the Go to Line dialog
msgid "Go to Line"
msgstr "指定行へ移動"

#. TRANSLATORS: Label for the input field where users enter the target line number.
msgid "&Line number:"
msgstr "行番号(&L):"

#. TRANSLATORS: Label for the button that jumps to the entered position (a line, page, or percentage, depending on the dialog)
msgid "Go"
msgstr "移動"

#. TRANSLATORS: Title of the Go to page dialog
msgid "Go to page"
msgstr "指定ページへ移動"

#. TRANSLATORS: Label/prompt template for the page selection dialog. The %d placeholders represent current_page and max_pages respectively.
#, c-format
msgid "Go to page (%d/%d):"
msgstr "ページ数(%d/%d):"

#. TRANSLATORS: Title of the Go to Percent dialog
msgid "Go to Percent"
msgstr "パーセント移動"

#. TRANSLATORS: Label for the percentage selection slider
msgid "&Percent"
msgstr "パーセント(&P)"

#. TRANSLATORS: Label for the numeric percentage entry field
msgid "P&ercent:"
msgstr "パーセント(&E):"

#. TRANSLATORS: Title of the Open As dialog
msgid "Open As"
msgstr "読み込み形式の指定"

#. TRANSLATORS: Prompt template informing the user that no parser was found for their file. The {} placeholder is replaced with the file path.
msgid ""
"No suitable parser was found for {}.\n"
"How would you like to open this file?"
msgstr ""
"{}に対応したパーサーが見つかりませんでした。\n"
"このファイルをどのように開きますか？"

#. TRANSLATORS: Label for the format selection dropdown
msgid "Open &as:"
msgstr "読み込み形式(&A):"

#. TRANSLATORS: Choice option to open a file as plain text
msgid "Plain Text"
msgstr "プレーンテキスト"

#. TRANSLATORS: Choice option to open a file as HTML
msgid "HTML"
msgstr "HTML"

#. TRANSLATORS: Choice option to open a file as Markdown
msgid "Markdown"
msgstr "Markdown"

#. TRANSLATORS: Title of the Options dialog
msgid "Options"
msgstr "オプション"

#. TRANSLATORS: Option to restore documents that were open when the app was last closed
msgid "&Restore previously opened documents on startup"
msgstr "起動時に前回の文書を開く(&R)"

#. TRANSLATORS: Option to toggle word wrapping of text
msgid "&Word wrap"
msgstr "ワードラップ(&W)"

#. TRANSLATORS: Option to render tables inline rather than showing a placeholder link
msgid "Render tables &inline"
msgstr "テーブルをインライン表示(&I)"

#. TRANSLATORS: Option to minimize the app window to the system tray instead of the taskbar
msgid "&Minimize to system tray"
msgstr "システムトレーに最小化(&M)"

#. TRANSLATORS: Option to start the app maximized
msgid "&Start maximized"
msgstr "最大化して起動(&S)"

#. TRANSLATORS: Option to show a compact Go navigation menu in the menu bar
msgid "Show compact &go menu"
msgstr "[移動]メニューをコンパクト表示(&G)"

#. TRANSLATORS: Option to wrap navigation around to the beginning/end when navigating elements
msgid "&Wrap navigation"
msgstr "ナビゲーションの折り返し(&W)"

#. TRANSLATORS: Option to play sound effects when bookmarks or notes are encountered
msgid "Play &sounds on bookmarks and notes"
msgstr "しおりとメモでサウンドを再生(&S)"

#. TRANSLATORS: Option to check for app updates automatically on startup
msgid "Check for &updates on startup"
msgstr "起動時に更新を確認(&U)"

#. TRANSLATORS: Button label to open the hotkey customization dialog
msgid "Customize &Window Hotkey..."
msgstr "ウィンドウを開くホットキーの変更(&W)..."

#. TRANSLATORS: Label for the reading speed input field (Words Per Minute)
msgid "&Reading speed (words per minute):"
msgstr "閲覧速度（単語/分）(&R):"

#. TRANSLATORS: Label for the number of recently opened documents to keep in history
msgid "Number of &recent documents to show:"
msgstr "最近開いた文書の表示件数(&R):"

#. TRANSLATORS: Label for the language selection dropdown
msgid "&Language:"
msgstr "言語(&L):"

#. TRANSLATORS: Label for the update channel selection dropdown
msgid "Update Channel:"
msgstr "更新チャンネル:"

#. TRANSLATORS: Stable update channel option
msgid "Stable"
msgstr "安定版"

#. TRANSLATORS: Developer/development update channel option
msgid "Dev"
msgstr "開発版"

#. TRANSLATORS: Label/header for the Font options section
msgid "Font"
msgstr "フォント"

#. TRANSLATORS: Button label to pick a font
msgid "Choose &Font..."
msgstr "フォントの選択(&F)..."

#. TRANSLATORS: Button label to restore font settings to default values
msgid "&Reset to Default Font"
msgstr "既定のフォントに戻す(&R)"

#. TRANSLATORS: Label/header for the Background Color options section
msgid "Background Color"
msgstr "背景色"

#. TRANSLATORS: Button label to pick a background color
msgid "Choose &Background Color..."
msgstr "背景色の変更(&B)..."

#. TRANSLATORS: Button label to restore background color to default values
msgid "Reset to &Default Background"
msgstr "既定の背景色に戻す(&D)"

#. TRANSLATORS: Label for the line spacing dropdown
msgid "&Line spacing:"
msgstr "行の間隔(&L):"

#. TRANSLATORS: Default spacing option (as opposed to relaxed/wide), shown in the line, paragraph, and letter spacing dropdowns
msgid "Normal"
msgstr "標準"

#. TRANSLATORS: 1.5x line spacing option
msgid "1.5\\u{00d7}"
msgstr "1.5倍"

#. TRANSLATORS: Double line spacing option
msgid "Double"
msgstr "2倍"

#. TRANSLATORS: Label for the paragraph spacing dropdown
msgid "&Paragraph spacing:"
msgstr "段落の間隔(&P):"

#. TRANSLATORS: Relaxed paragraph spacing option
msgid "Relaxed"
msgstr ""

#. TRANSLATORS: Wide spacing option, shown in the paragraph and letter spacing dropdowns
msgid "Wide"
msgstr ""

#. TRANSLATORS: Label for the letter spacing dropdown
msgid "L&etter spacing:"
msgstr "文字の間隔(&E):"

#. TRANSLATORS: Very Wide letter spacing option
msgid "Very Wide"
msgstr ""

#. TRANSLATORS: Label for the text alignment dropdown
msgid "Text &alignment:"
msgstr "テキストの配置(&A):"

#. TRANSLATORS: Left text alignment option
msgid "Left"
msgstr ""

#. TRANSLATORS: Center text alignment option
msgid "Center"
msgstr ""

#. TRANSLATORS: Right text alignment option
msgid "Right"
msgstr ""

#. TRANSLATORS: Justified text alignment option
msgid "Justify"
msgstr ""

#. TRANSLATORS: Tab label for the General options panel
msgid "General"
msgstr "一般"

#. TRANSLATORS: Tab label for the Reading options panel
msgid "Reading"
msgstr "閲覧"

#. TRANSLATORS: Tab label for the Readability options panel
msgid "Readability"
msgstr "表示"

#. TRANSLATORS: Description text shown when the background color is set to default
msgid "Background: Default"
msgstr "背景色: 既定"

#. TRANSLATORS: Description text shown when the font is set to default
msgid "Font: Default"
msgstr "フォント: 既定"

#. TRANSLATORS: Fallback font name
msgid "Default"
msgstr "既定"

#. TRANSLATORS: Font description prefix; {} is the font face name
msgid "Font: {}"
msgstr "フォント: {}"

#. TRANSLATORS: Point size attribute; {} is the numeric size, "pt" is the unit abbreviation
msgid "{}pt"
msgstr "{}ポイント"

#. TRANSLATORS: Font weight attribute name
msgid "Bold"
msgstr "太字"

#. TRANSLATORS: Font style attribute name
msgid "Italic"
msgstr "斜体"

#. TRANSLATORS: Font underline attribute name
msgid "Underlined"
msgstr "下線"

#. TRANSLATORS: Font strikethrough attribute name
msgid "Strikethrough"
msgstr "取り消し線"

#. TRANSLATORS: Title of the hotkey customization dialog
msgid "Window Hotkey"
msgstr "ウィンドウを開くホットキー"

#. TRANSLATORS: Checkbox label for Control modifier key
msgid "&Ctrl"
msgstr "&Ctrl"

#. TRANSLATORS: Checkbox label for Alt modifier key
msgid "&Alt"
msgstr "&Alt"

#. TRANSLATORS: Checkbox label for Shift modifier key
msgid "&Shift"
msgstr "&Shift"

#. TRANSLATORS: Checkbox label for Windows modifier key
msgid "&Win"
msgstr "&Win"

#. TRANSLATORS: Label for the hotkey key selection input field
msgid "&Key:"
msgstr "キー(&K):"

#. TRANSLATORS: Button label to clear the current hotkey selection
msgid "Clear"
msgstr "設定解除"

#. TRANSLATORS: Representation of the Spacebar key
msgid "Space"
msgstr "Space"

#. TRANSLATORS: Title of the Sleep Timer dialog
msgid "Sleep Timer"
msgstr "スリープタイマー"

#. TRANSLATORS: Label for the input field where users enter the number of minutes for the sleep timer.
msgid "&Minutes:"
msgstr "分(&M):"

#. TRANSLATORS: Title of the Table of Contents dialog
msgid "Table of Contents"
msgstr "目次"

#. TRANSLATORS: Error message shown when the user attempts to confirm the Table of Contents dialog without having selected any section
msgid "Please select a section from the table of contents."
msgstr "目次からセクションを選択してください。"

#. TRANSLATORS: Title of the error dialog shown when the user attempts to confirm the Table of Contents dialog without having selected any section
msgid "No Selection"
msgstr "選択なし"

#. TRANSLATORS: Title of the View Note dialog
msgid "View Note"
msgstr "メモの表示"

#. TRANSLATORS: Singular label for 1 hour duration
msgid "1 hour"
msgstr "1時間"

#. TRANSLATORS: Plural label for hours duration (e.g. "2 hours")
msgid "hours"
msgstr "時間"

#. TRANSLATORS: Singular label for 1 minute duration
msgid "1 minute"
msgstr "1分"

#. TRANSLATORS: Plural label for minutes duration (e.g. "2 minutes")
msgid "minutes"
msgstr "分"

#. TRANSLATORS: Singular label for 1 second duration
msgid "1 second"
msgstr "1秒"

#. TRANSLATORS: Plural label for seconds duration (e.g. "2 seconds")
msgid "seconds"
msgstr "秒"

#. TRANSLATORS: Prompt showing estimated reading time. The {} placeholder is replaced with a formatted duration like "1 hour, 5 minutes".
msgid "Estimated reading time: {}"
msgstr "推定閲覧時間: {}"

#. TRANSLATORS: Message template for selection word count. The {} placeholder is replaced with the number of words.
msgid "The selection contains {} words."
msgstr "選択範囲の単語数は{}です。"

#. TRANSLATORS: Message template for document word count. The {} placeholder is replaced with the number of words.
msgid "This document contains {} words."
msgstr "この文書の単語数は{}です。"

#. TRANSLATORS: Title of the Word Count dialog
msgid "Word Count"
msgstr "単語数"

#. TRANSLATORS: Error message shown when the requested document file does not exist; {} is the file path
msgid "File not found: {}"
msgstr "ファイルが見つかりません: {}"

#. TRANSLATORS: Prompt asking whether to import a document's previously saved settings and bookmarks found alongside it
msgid "A .paperback file was found for this document. Would you like to import it?"
msgstr "この文書用の.paperbackファイルが見つかりました。インポートしますか？"

#. TRANSLATORS: Title of the dialog prompting to import a document's saved settings and bookmarks
msgid "Import document data"
msgstr "文書データのインポート"

#. TRANSLATORS: Error shown when the user dismisses the password prompt for an encrypted document without entering one
msgid "Password is required."
msgstr "パスワードが必要です。"

#. TRANSLATORS: Announcement read by screen readers after following an internal link within the document
msgid "Navigated to internal link."
msgstr "リンク先へ移動しました。"

#. TRANSLATORS: Default status bar text when no document is open
msgid "Ready"
msgstr "準備完了"

#. TRANSLATORS: Title of the dialog showing a table rendered as HTML when activated with Enter/Space
msgid "Table View"
msgstr "テーブルビュー"

#. TRANSLATORS: Label for the password entry field in the "Document Password" prompt dialog
msgid "&Password:"
msgstr "パスワード(&P):"

msgid "Document Password"
msgstr "文書のパスワード"

#. TRANSLATORS: Generic error message shown when a document fails to load with no further detail available
msgid "Failed to load document."
msgstr "文書の読み込みに失敗しました。"

#. TRANSLATORS: "File" label prefix in the document-load error dialog; {} is the file path
msgid "File: {}"
msgstr "ファイル: {}"

#. TRANSLATORS: "Details" label prefix in the document-load error dialog; {} is the underlying error message
msgid "Details: {}"
msgstr "詳細: {}"

#. TRANSLATORS: Right-click context menu item and status text to bookmark the current position
msgid "Create &bookmark"
msgstr "しおりの作成(&B)"

msgid "Create bookmark"
msgstr "しおりを作成します"

#. TRANSLATORS: Right-click context menu item and status text to bookmark the current position with an attached note
msgid "Bookmark with &note"
msgstr "メモ付きのしおりを作成(&N)"

msgid "Create bookmark with note"
msgstr "メモ付きのしおりを作成します"

#. TRANSLATORS: Right-click context menu item and status text to open the find dialog
msgid "&Find"
msgstr "検索(&F)"

msgid "Find text"
msgstr "テキストを検索します"

#. TRANSLATORS: Right-click context menu item and status text to repeat the last search forward
msgid "Find &next"
msgstr "次を検索(&N)"

msgid "Find next match"
msgstr "次のテキストを検索します"

#. TRANSLATORS: Right-click context menu item and status text to repeat the last search backward
msgid "Find &previous"
msgstr "前を検索(&P)"

msgid "Find previous match"
msgstr "前のテキストを検索します"

#. TRANSLATORS: Right-click context menu item and status text to jump to a specific page
msgid "Go to &page"
msgstr "指定ページへ移動(&P)"

#. TRANSLATORS: Right-click context menu item and status text to jump to a specific line
msgid "Go to &line"
msgstr "指定行へ移動(&L)"

msgid "Go to line"
msgstr "指定した行へ移動します"

#. TRANSLATORS: Right-click context menu item and status text to jump to a percentage through the document
msgid "Go to &percent"
msgstr "パーセント移動(&P)"

msgid "Go to percent"
msgstr "パーセントを指定して移動します"

#. TRANSLATORS: Title of the Find dialog
msgid "Find"
msgstr "検索"

#. TRANSLATORS: Label for the text field where the user types what to search for
msgid "Find &what:"
msgstr "検索文字列(&W):"

#. TRANSLATORS: Checkbox to make the search case-sensitive
msgid "&Match case"
msgstr "大文字/小文字を区別(&M)"

#. TRANSLATORS: Checkbox to only match whole words, not substrings
msgid "Match &whole word"
msgstr "単語単位で検索(&W)"

#. TRANSLATORS: Checkbox to treat the search text as a regular expression
msgid "Use &regular expressions"
msgstr "正規表現を使用(&R)"

#. TRANSLATORS: Button to search backward for the previous match
msgid "Find &Previous"
msgstr "前を検索(&P)"

#. TRANSLATORS: Button to search forward for the next match
msgid "Find &Next"
msgstr "次を検索(&N)"

#. TRANSLATORS: Announced when a search finds no matches in the document
msgid "Not found."
msgstr "見つかりません。"

#. TRANSLATORS: Announced when a search reaches the end of the document and wraps back to the start
msgid "No more results. Wrapping search."
msgstr "これ以上見つかりません。折り返して検索します。"

#. TRANSLATORS: Error shown when the active document has no known file path to reveal
msgid "Failed to reveal file in folder."
msgstr "ファイルの場所を開けません。"

#. TRANSLATORS: Error shown when the bundled help/readme file could not be located on disk
msgid "readme.html not found. Please ensure the application was built properly."
msgstr "readme.htmlが見つかりません。アプリケーションが正しくビルドされていることをご確認ください。"

#. TRANSLATORS: Error shown when the OS default web browser could not be launched to display help
msgid "Failed to launch default browser."
msgstr "既定のブラウザーを起動できません。"

#. TRANSLATORS: Error shown when the OS default web browser could not be launched to open the donation page
msgid "Failed to open donation page in browser."
msgstr "ブラウザーで寄付ページを開けません。"

#. TRANSLATORS: Error shown when the user picks a file format from the "Open As" dialog that this parser build doesn't support
msgid "Unsupported format selected."
msgstr "選択した形式には対応していません。"

#. TRANSLATORS: Main window title when no document is open
msgid "Paperback"
msgstr "Paperback"

#. TRANSLATORS: Message shown when the user tries to perform an action while a help/documentation Web View window is open
msgid "Paperback cannot perform any actions while Web View is open."
msgstr "Webビューが開いている間はアクションを実行できません。"

#. TRANSLATORS: Window title when a document is open; {} is the document title
msgid "Paperback - {}"
msgstr "Paperback - {}"

#. TRANSLATORS: Status bar character count; {} is the number of characters
msgid "{} chars"
msgstr "{}文字"

#. TRANSLATORS: Title of the file picker dialog shown when opening a document
msgid "Open Document"
msgstr "文書を開く"

#. TRANSLATORS: Announced when "Go to Page" is used on a document that has no page numbers
msgid "No pages."
msgstr "ページがありません。"

#. TRANSLATORS: Announced when toggling word wrap; the message reflects the new state
msgid "Word wrap on."
msgstr "ワードラップ オン"

msgid "Word wrap off."
msgstr "ワードラップ オフ"

#. TRANSLATORS: Fallback file name stem used when the document's path has no file stem
msgid "document"
msgstr "文書"

#. TRANSLATORS: File filter shown in the "Export to plain text" save dialog
msgid "Plain text files (*.txt)|*.txt|All files (*.*)|*.*"
msgstr "プレーンテキストファイル(*.txt)|*.txt|すべてのファイル(*.*)|*.*"

#. TRANSLATORS: Title of the file save dialog when exporting a document to plain text
msgid "Export document to plain text"
msgstr "文書をプレーンテキストにエクスポート"

#. TRANSLATORS: Error dialog shown when exporting a document to another format fails
msgid "Failed to export document."
msgstr "文書のエクスポートに失敗しました。"

#. TRANSLATORS: File filter shown in the "Export to HTML" save dialog
msgid "HTML files (*.html)|*.html|All files (*.*)|*.*"
msgstr "HTMLファイル(*.html)|*.html|すべてのファイル(*.*)|*.*"

#. TRANSLATORS: Title of the file save dialog when exporting a document to HTML
msgid "Export document to HTML"
msgstr "文書をHTMLにエクスポート"

#. TRANSLATORS: File filter shown in the "Export to Markdown" save dialog
msgid "Markdown files (*.md)|*.md|All files (*.*)|*.*"
msgstr "Markdownファイル(*.md)|*.md|すべてのファイル(*.*)|*.*"

#. TRANSLATORS: Title of the file save dialog when exporting a document to Markdown
