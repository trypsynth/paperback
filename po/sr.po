#. TRANSLATORS: Title of the error dialog shown when the user attempts to confirm the Table of Contents dialog without having selected any section
msgid "No Selection"
msgstr "Bez izbora"

#. TRANSLATORS: Title of the View Note dialog
msgid "View Note"
msgstr "Prikaži napomenu"

#. TRANSLATORS: Duration segment for hours in the estimated reading time (e.g. "1 hour" / "5 hours"). The %d placeholder is replaced with the count.
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d sat"
msgstr[1] "%d sata"
msgstr[2] "%d sati"

#. TRANSLATORS: Duration segment for minutes in the estimated reading time (e.g. "1 minute" / "5 minutes"). The %d placeholder is replaced with the count.
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d minut"
msgstr[1] "%d minuta"
msgstr[2] "%d minuta"

