#. TRANSLATORS: Error message shown when another app instance's IPC pipe already exists and a new one can't be created
msgid "Failed to create IPC server"
msgstr "Nemoguće napraviti IPC server"

#. TRANSLATORS: Title of a warning dialog
msgid "Warning"
msgstr "Upozorenje"

#. TRANSLATORS: Description/tagline of the application shown in the About dialog
msgid "An accessible, lightweight, fast ebook and document reader"
msgstr "Pristupačan, lagan, brz čitač digitalnih knjiga i dokumenata"

#. TRANSLATORS: Title of the All Documents dialog
msgid "All Documents"
msgstr "Svi dokumenti"

#. TRANSLATORS: Label for the search input field in the All Documents dialog
msgid "&search"
msgstr "&Pretraga"

#. TRANSLATORS: Column header for the document filename in the All Documents list
msgid "File Name"
msgstr "Ime datoteke"

#. TRANSLATORS: Column header for the document status (e.g. Open, Closed, Missing) in the All Documents list
msgid "Status"
msgstr "Status"

#. TRANSLATORS: Column header for the file path in the All Documents list
msgid "Path"
msgstr "Putanja"

#. TRANSLATORS: Label for the status filter dropdown in the All Documents dialog
msgid "&Status:"
msgstr "&Stanje:"

#. TRANSLATORS: Option in the All Documents status filter to show documents of every status
#. TRANSLATORS: Option in the filter dropdown to show all entries
msgid "All"
msgstr "Sve"

#. TRANSLATORS: Status of a document that is currently open in a tab
msgid "Open"
msgstr "Otvori"

#. TRANSLATORS: Status of a document that was previously opened but is currently closed
msgid "Closed"
msgstr "Zatvoreno"

#. TRANSLATORS: Status of a document whose file could not be found on disk
msgid "Missing"
msgstr "Nedostaje"

#. TRANSLATORS: Button label to open the selected document
msgid "&Open"
msgstr "&Otvori"

#. TRANSLATORS: Button label to locate a missing file on disk
msgid "&Locate…"
msgstr "&Lociraj…"

#. TRANSLATORS: Button label to remove selected documents from the list
msgid "&Remove"
msgstr "&Ukloni"

#. TRANSLATORS: Button label to clear all documents from the list
msgid "&Clear All"
msgstr "&Očisti sve"

#. TRANSLATORS: Label for a button that closes a dialog
msgid "Close"
msgstr "Zatvori"

msgid ""
"Are you sure you want to remove the selected document? This will also remove "
"its reading position and bookmarks."
msgstr ""
"Da li ste sigurni da želite da uklonite izabrani dokument? Ovo će takođe "
"ukloniti njegovu poziciju čitanja i knjižne oznake."

msgid ""
"Are you sure you want to remove the {} selected documents? This will also "
"remove their reading positions and bookmarks."
msgstr ""
"Da li ste sigurni da želite da uklonite {} izabranih dokumenata? Ovo će "
"takođe ukloniti njihove pozicije čitanja i knjižne oznake."

#. TRANSLATORS: Title of the confirmation dialog
msgid "Confirm"
msgstr "Potvrdi"

#. TRANSLATORS: Confirmation prompt when clearing all documents from the list.
msgid ""
"Are you sure you want to remove all documents from the list? This will also "
"remove all reading positions and bookmarks."
msgstr ""
"Da li ste sigurni da želite da uklonite sve dokumente iz liste? Ovo će "
"takođe ukloniti sve pozicije čitanja i knjižne oznake."

#. TRANSLATORS: Status bar text in the All Documents dialog when the list is empty
msgid "No documents."
msgstr "Nema dokumenata."

#. TRANSLATORS: Status bar text in the All Documents dialog showing the total number of documents in the list. The %d placeholder is replaced with the count. Plural form is chosen by that count.
msgid "%d document."
msgid_plural "%d documents."
msgstr[0] "%d dokument."
msgstr[1] "%d dokumenta."
msgstr[2] "%d dokumenata."

#. TRANSLATORS: Status bar text in the All Documents dialog when the single document in the list is selected
msgid "1 of 1 document selected."
msgstr "1 od 1 dokument je izabran."

#. TRANSLATORS: Status bar text in the All Documents dialog when every document in the list is selected. The %d placeholder is replaced with the total count. Plural form is chosen by that count.
msgid "All %d document selected."
msgid_plural "All %d documents selected."
msgstr[0] "%d dokument izabran."
msgstr[1] "%d dokumenta izabrana."
msgstr[2] "%d dokumenata izabrano."

#. TRANSLATORS: Status bar text in the All Documents dialog showing how many of the total documents are selected. The first %d is the selected count, the second %d is the total count. Plural form is chosen by the total count.
msgid "%d of %d document selected."
msgid_plural "%d of %d documents selected."
msgstr[0] "%d od %d dokument izabran."
msgstr[1] "%d od %d dokumenta izabrana."
msgstr[2] "%d od %d dokumenata izabrano."

#. TRANSLATORS: Message/prompt shown in the file picker dialog to locate a missing book
msgid "Locate Book"
msgstr "Lociraj knjigu"

#. TRANSLATORS: Title of the Jump to Bookmark dialog
msgid "Jump to Bookmark"
msgstr "Skoči na knjižnu oznaku"

#. TRANSLATORS: Label for the bookmark filter dropdown
msgid "&Filter:"
msgstr "&Filter:"

#. TRANSLATORS: Option in the filter dropdown to show bookmarks only
msgid "Bookmarks"
msgstr "Knjižne oznake"

#. TRANSLATORS: Option in the filter dropdown to show notes only
msgid "Notes"
msgstr "Napomene"

#. TRANSLATORS: Label for the bookmark/note list (used only as an accessibility label on macOS)
msgid "&Bookmarks:"
msgstr "&knjižne oznake:"

