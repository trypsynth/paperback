#. TRANSLATORS: Error when downloading a document from a link fails; {} is the HTTP status code, such as 404
msgid "the server answered with status {}"
msgstr "a kiszolgáló a következő állapotkóddal válaszolt: {}"

#. TRANSLATORS: Error when the server of a link cannot be reached; {} is the technical reason
msgid "the server could not be reached: {}"
msgstr "a kiszolgáló nem érhető el: {}"

#. TRANSLATORS: Error when a document downloaded from a link cannot be saved; {} is the technical reason
msgid "the download could not be saved: {}"
msgstr "a letöltött fájlt nem sikerült menteni: {}"

#. TRANSLATORS: Message when downloading a document from a link is cancelled
msgid "the download was cancelled"
msgstr "a letöltés megszakítva"

#. TRANSLATORS: Error when a link names a file type that is never downloaded; {} is the extension without the leading dot
msgid ".{} files cannot be read, so the link was not downloaded"
msgstr "ez a fájltípus (.{}) nem olvasható, ezért a Paperback nem töltötte le"

#. TRANSLATORS: Error when a secure https link is redirected to an insecure http address
msgid "the secure link was redirected to an insecure address, so it was not downloaded"
msgstr "a biztonságos hivatkozás nem biztonságos címre irányít át, ezért a Paperback nem töltötte le"

#. TRANSLATORS: Error when a document behind a link is too large to download; {} is the limit in megabytes
msgid "the document is larger than {} MB, so it was not downloaded"
msgstr "a dokumentum nagyobb, mint {} MB, ezért a Paperback nem töltötte le"

