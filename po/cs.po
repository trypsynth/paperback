msgid "Increase how far seeking the audio narration moves"
msgstr "Prodlouží úsek, o který přetáčení posouvá zvukovou stopu"

#. TRANSLATORS: Menu item in the Tools menu to decrease the amount of time each audio seek skips.
msgid "&Decrease Audio Seek Amount"
msgstr "&Zkrátit interval přetáčení"

#. TRANSLATORS: Status-bar help text for the Decrease Audio Seek Amount menu item.
msgid "Decrease how far seeking the audio narration moves"
msgstr "Zkrátí úsek, o který přetáčení posouvá zvukovou stopu"

#. TRANSLATORS: Description/tagline of the application shown in the About dialog
msgid "An accessible, lightweight, fast ebook and document reader"
msgstr "Přístupná, úsporná a rychlá čtečka e-knih a dokumentů"

#. TRANSLATORS: Title of the All Documents dialog
msgid "All Documents"
msgstr "Všechny dokumenty"

#. TRANSLATORS: Label for the search input field in the All Documents dialog
msgid "&search"
msgstr "&Hledat"

#. TRANSLATORS: Column header for the document filename in the All Documents list
msgid "File Name"
msgstr "Název souboru"

#. TRANSLATORS: Column header for the document status (e.g. Open, Closed, Missing) in the All Documents list
msgid "Status"
msgstr "Stav"

#. TRANSLATORS: Column header for the file path in the All Documents list
msgid "Path"
msgstr "Cesta"

#. TRANSLATORS: Label for the status filter dropdown in the All Documents dialog
msgid "&Status:"
msgstr "&Stav:"

