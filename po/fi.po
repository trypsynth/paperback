#. TRANSLATORS: Error message shown when another app instance's IPC pipe already exists and a new one can't be created
msgid "Failed to create IPC server"
msgstr "IPC-palvelimen luonti epäonnistui"

#. TRANSLATORS: Title of a warning dialog
msgid "Warning"
msgstr "Varoitus"

#. TRANSLATORS: Description/tagline of the application shown in the About dialog
msgid "An accessible, lightweight, fast ebook and document reader"
msgstr "Kevyt ja saavutettava e- ja asiakirjojen lukija"

#. TRANSLATORS: Title of the All Documents dialog
msgid "All Documents"
msgstr "Kaikki asiakirjat"

#. TRANSLATORS: Label for the search input field in the All Documents dialog
msgid "&search"
msgstr "&Haku"

#. TRANSLATORS: Column header for the document filename in the All Documents list
msgid "File Name"
msgstr "Tiedostonimi"

#. TRANSLATORS: Column header for the document status (e.g. Open, Closed, Missing) in the All Documents list
msgid "Status"
msgstr "Tila"

#. TRANSLATORS: Column header for the file path in the All Documents list
msgid "Path"
msgstr "Polku"

#. TRANSLATORS: Label for the status filter dropdown in the All Documents dialog
msgid "&Status:"
msgstr "T&ila:"

#. TRANSLATORS: Option in the All Documents status filter to show documents of every status
#. TRANSLATORS: Option in the filter dropdown to show all entries
msgid "All"
msgstr "Kaikki"

#. TRANSLATORS: Status of a document that is currently open in a tab
msgid "Open"
msgstr "Avoinna"

#. TRANSLATORS: Status of a document that was previously opened but is currently closed
msgid "Closed"
msgstr "Suljettu"

#. TRANSLATORS: Status of a document whose file could not be found on disk
#. TRANSLATORS: Status of a document whose file could not be found on disk. Compared against the row's displayed status to decide whether the Open button is enabled.
#. TRANSLATORS: Status of a document whose file could not be found on disk. Compared against the selected row's displayed status to decide whether the Locate button is enabled.
msgid "Missing"
msgstr "Ei löydy"

#. TRANSLATORS: Button label to open the selected document
msgid "&Open"
msgstr "&Avaa"

#. TRANSLATORS: Button label to locate a missing file on disk
#| msgid "Locate"
msgid "&Locate..."
msgstr "Et&si..."

#. TRANSLATORS: Button label to remove selected documents from the list
msgid "&Remove"
msgstr "&Poista"

#. TRANSLATORS: Button label to clear all documents from the list
msgid "&Clear All"
msgstr "P&oista kaikki"

#. TRANSLATORS: Label for a button that closes a dialog
#. TRANSLATORS: Label for a button that closes the Document Info dialog
#. TRANSLATORS: Label for a button that closes the View Note dialog
#. TRANSLATORS: Label for a button that closes the Web View dialog
#. TRANSLATORS: Name of this keyboard-shortcut action, shown in the Customize Keyboard Shortcuts dialog (its list of assignable actions, and the "Set Shortcut for {}" / conflict-reassignment prompts).
msgid "Close"
msgstr "Sulje"

msgid ""
"Are you sure you want to remove the selected document? This will also remove "
"its reading position and bookmarks."
msgstr ""
"Haluatko varmasti poistaa valitun asiakirjan? Myös lukukohta ja kirjanmerkit "
"poistetaan."

msgid ""
"Are you sure you want to remove the {} selected documents? This will also "
"remove their reading positions and bookmarks."
msgstr ""
"Haluatko varmasti poistaa {} valittua asiakirjaa? Myös lukukohdat ja "
"kirjanmerkit poistetaan."

#. TRANSLATORS: Title of the confirmation dialog
msgid "Confirm"
msgstr "Vahvista"

#. TRANSLATORS: Confirmation prompt when clearing all documents from the list.
msgid ""
"Are you sure you want to remove all documents from the list? This will also "
"remove all reading positions and bookmarks."
msgstr ""
"Haluatko varmasti poistaa luettelosta kaikki asiakirjat? Myös lukukohdat ja "
"kirjanmerkit poistetaan."

#. TRANSLATORS: Status bar text in the All Documents dialog when the list is empty
msgid "No documents."
msgstr "Asiakirjoja ei ole."

#. TRANSLATORS: Status bar text in the All Documents dialog showing the total number of documents in the list. The %d placeholder is replaced with the count. Plural form is chosen by that count.
msgid "%d document."
msgid_plural "%d documents."
msgstr[0] "%d asiakirja."
msgstr[1] "%d asiakirjaa."

#. TRANSLATORS: Status bar text in the All Documents dialog when the only document in the list is selected
#| msgid "1 of 1 document selected."
msgid "1 document selected."
msgstr "1 asiakirja valittuna."

#. TRANSLATORS: Status bar text in the All Documents dialog when every document in the list is selected. The %d placeholder is replaced with the total count. Plural form is chosen by that count.
msgid "All %d document selected."
msgid_plural "All %d documents selected."
msgstr[0] "%d asiakirja valittuna."
msgstr[1] "Kaikki %d asiakirjaa valittuina."

#. TRANSLATORS: Status bar text in the All Documents dialog showing how many of the total documents are selected. The first %d is the selected count, the second %d is the total count. Plural form is chosen by the total count.
msgid "%d of %d document selected."
msgid_plural "%d of %d documents selected."
msgstr[0] "%d / %d asiakirjaa valittuna."
msgstr[1] "%d / %d asiakirjaa valittuina."

#. TRANSLATORS: Message/prompt shown in the file picker dialog to locate a missing book
msgid "Locate Book"
msgstr "Etsi kirja"

#. TRANSLATORS: Title of the Jump to Bookmark dialog
msgid "Jump to Bookmark"
msgstr "Siirry kirjanmerkkiin"

#. TRANSLATORS: Label for the bookmark filter dropdown
msgid "&Filter:"
msgstr "Su&odata:"

#. TRANSLATORS: Option in the filter dropdown to show bookmarks only
msgid "Bookmarks"
msgstr "Kirjanmerkit"

#. TRANSLATORS: Option in the filter dropdown to show notes only
msgid "Notes"
msgstr "Muistiinpanot"

#. TRANSLATORS: Label for the bookmark/note list (used only as an accessibility label on macOS)
msgid "&Bookmarks:"
msgstr "&Kirjanmerkit:"

#. TRANSLATORS: Label for the button to edit a note
msgid "&Edit Note"
msgstr "&Muokkaa muistiinpanoa"

#. TRANSLATORS: Label for the button to delete the selected bookmark/note
#. TRANSLATORS: Menu item in the Edit menu to delete the current selection.
msgid "&Delete"
msgstr "&Poista"

#. TRANSLATORS: Label for the button to jump to the selected bookmark
msgid "&Jump"
msgstr "&Siirry"

#. TRANSLATORS: Label for the button to cancel the action
msgid "&Cancel"
msgstr "&Peruuta"

#. TRANSLATORS: Placeholder text shown in the bookmarks list when the bookmark text range is empty or blank
msgid "blank"
msgstr "tyhjä"

#. TRANSLATORS: Error message shown when the user attempts to jump without selecting any bookmark
msgid "Please select a bookmark to jump to."
msgstr "Valitse kirjanmerkki, johon siirrytään."

#. TRANSLATORS: Generic error dialog title
msgid "Error"
msgstr "Virhe"

#. TRANSLATORS: Title of the Bookmark Note editor dialog
#. TRANSLATORS: Title of the dialog for adding or editing a bookmark note
msgid "Bookmark Note"
msgstr "Kirjanmerkin muistiinpano"

#. TRANSLATORS: Label/prompt in the Note editor dialog
msgid "Edit bookmark note:"
msgstr "Muokkaa kirjanmerkin muistiinpanoa:"

#. TRANSLATORS: Title of the Document Info dialog
#. TRANSLATORS: Name of this keyboard-shortcut action, shown in the Customize Keyboard Shortcuts dialog (its list of assignable actions, and the "Set Shortcut for {}" / conflict-reassignment prompts).
msgid "Document Info"
msgstr "Asiakirjan tiedot"

#. TRANSLATORS: Label for the document's file path
msgid "Path:"
msgstr "Polku:"

#. TRANSLATORS: Label for the document's title
msgid "Title:"
msgstr "Nimi:"

#. TRANSLATORS: Label for the document's author
msgid "Author:"
msgstr "Tekijä:"

#. TRANSLATORS: Label for the number of words in the document
msgid "Words:"
msgstr "Sanojen määrä:"

#. TRANSLATORS: Label for the number of lines in the document
msgid "Lines:"
msgstr "Rivien määrä:"

#. TRANSLATORS: Label for the number of characters in the document
msgid "Characters:"
msgstr "Merkkien määrä:"

#. TRANSLATORS: Label for the number of characters in the document excluding space characters
msgid "Characters (excluding spaces):"
msgstr "Merkkien määrä (ilman välilyöntejä):"

#. TRANSLATORS: Title of the Elements dialog
msgid "Elements"
msgstr "Elementit"

#. TRANSLATORS: Label for the view selection dropdown in the Elements dialog
msgid "&View:"
msgstr "&Näytä:"

#. TRANSLATORS: Choice option in the view dropdown to show headings list
msgid "Headings"
msgstr "Otsikot"

#. TRANSLATORS: Choice option in the view dropdown to show links list
msgid "Links"
msgstr "Linkit"

#. TRANSLATORS: Placeholder text shown in the elements list when a document element has no text content
#. TRANSLATORS: Placeholder text shown in the table of contents tree when an entry has no title
#. TRANSLATORS: Fallback document title shown in tabs and lists when a document has no title and its file name cannot be determined
msgid "Untitled"
msgstr "Nimetön"

#. TRANSLATORS: Label for the confirmation button
#. TRANSLATORS: OK button that confirms the entered bookmark/note text
#. TRANSLATORS: OK button that confirms the chosen file format in the Open As dialog
#. TRANSLATORS: Label for the confirmation button
#. TRANSLATORS: OK button that saves the customized shortcuts in the Keyboard Shortcuts dialog.
#. TRANSLATORS: OK button in the Set Shortcut dialog that accepts the captured key combination.
#. TRANSLATORS: OK button that confirms the entered sleep timer duration
#. TRANSLATORS: Label for the confirmation button
msgid "OK"
msgstr "OK"

#. TRANSLATORS: Title of the Go to Line dialog
msgid "Go to Line"
msgstr "Siirry riville"

#. TRANSLATORS: Label for the input field where users enter the target line number.
msgid "&Line number:"
msgstr "R&ivinumero:"

#. TRANSLATORS: Label for the button that jumps to the entered position (a line, page, or percentage, depending on the dialog)
#. TRANSLATORS: Name of the "Go" (navigation) category of keyboard shortcuts, shown as a tab label in the Customize Keyboard Shortcuts dialog
msgid "Go"
msgstr "Siirry"

#. TRANSLATORS: Title of the Go to page dialog
msgid "Go to page"
msgstr "Siirry sivulle"

#. TRANSLATORS: Label/prompt template for the page selection dialog. The %d placeholders represent current_page and max_pages respectively.
msgid "Go to page (%d/%d):"
msgstr "Siirry sivulle (%d/%d):"

#. TRANSLATORS: Title of the Go to Percent dialog
msgid "Go to Percent"
msgstr "Siirry prosenttiin"

#. TRANSLATORS: Label for the percentage selection slider
msgid "&Percent"
msgstr "&Prosentti"

#. TRANSLATORS: Label for the numeric percentage entry field
msgid "P&ercent:"
msgstr "Pr&osentti:"

#. TRANSLATORS: Title of the Open As dialog
msgid "Open As"
msgstr "Avaa muodossa"

#. TRANSLATORS: Prompt template informing the user that no parser was found for their file. The {} placeholder is replaced with the file path.
msgid ""
"No suitable parser was found for {}.\n"
"How would you like to open this file?"
msgstr ""
"Tiedostolle {} ei löydy sopivaa jäsennintä.\n"
"Miten haluat avata tämän tiedoston?"

#. TRANSLATORS: Label for the format selection dropdown
msgid "Open &as:"
msgstr "Avaa &muodossa:"

#. TRANSLATORS: Choice option to open a file as plain text
msgid "Plain Text"
msgstr "Pelkkä teksti"

#. TRANSLATORS: Choice option to open a file as HTML
msgid "HTML"
msgstr "HTML"

#. TRANSLATORS: Choice option to open a file as Markdown
msgid "Markdown"
msgstr "Markdown"

#. TRANSLATORS: Title of the Settings dialog
msgid "Settings"
msgstr "Asetukset"

#. TRANSLATORS: Option to restore documents that were open when the app was last closed
msgid "&Restore previously opened documents on startup"
msgstr "Pala&uta aiemmin avatut asiakirjat käynnistettäessä"

#. TRANSLATORS: Option to toggle word wrapping of text
msgid "&Word wrap"
msgstr "Rivit&ys"

#. TRANSLATORS: Option to render tables inline rather than showing a placeholder link
msgid "Render tables &inline"
msgstr "Näytä taulukot tekst&in osana"

#. TRANSLATORS: Option to minimize the app window to the system tray instead of the taskbar
msgid "&Minimize to system tray"
msgstr "&Pienennä ilmaisinalueelle"

#. TRANSLATORS: Option to start the app maximized
msgid "&Start maximized"
msgstr "&Käynnistä suurennettuna"

#. TRANSLATORS: Option to show a compact Go navigation menu in the menu bar
msgid "Show compact &go menu"
msgstr "Näytä tiivis &Siirry-valikko"

#. TRANSLATORS: Option to wrap navigation around to the beginning/end when navigating elements
msgid "&Wrap navigation"
msgstr "Siirry a&lkuun asiakirjan lopussa"

#. TRANSLATORS: Option to move the caret to the start of the line when navigating up or down
msgid "Move to &start of line"
msgstr "Siirry rivin &alkuun"

#. TRANSLATORS: Option to play sound effects when bookmarks or notes are encountered
msgid "Play &sounds on bookmarks and notes"
msgstr "Ilmaise kirjanmerkit ja muistiinpanot merkkiäänellä"

#. TRANSLATORS: Option to move the reading caret to follow along with audio narration as it plays
msgid "&Sync caret to audio playback"
msgstr "&Kohdistin seuraa äänitteen toistokohtaa"

#. TRANSLATORS: Label for the audio seek amount dropdown, used when skipping audio narration backward/forward
msgid "&Audio seek amount:"
msgstr "&Äänitteen kelauksen aikasiirtymä:"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "5 seconds"
msgstr "5 sekuntia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "10 seconds"
msgstr "10 sekuntia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "30 seconds"
msgstr "30 sekuntia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "1 minute"
msgstr "1 minuutti"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "2 minutes"
msgstr "2 minuuttia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "5 minutes"
msgstr "5 minuuttia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "10 minutes"
msgstr "10 minuuttia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "30 minutes"
msgstr "30 minuuttia"

#. TRANSLATORS: Audio seek amount option, shown in the audio seek amount dropdown
#. TRANSLATORS: Audio seek amount, announced after changing it via keyboard shortcut
msgid "1 hour"
msgstr "1 tunti"

#. TRANSLATORS: Option controlling whether seeking audio narration past the end of a chapter's file continues into the next chapter, or stops at the end of the current one
msgid "Seeking &past the end of a chapter continues into the next"
msgstr ""
"Jatka toistoa &seuraavasta luvusta nykyisen luvun loppua pidemmälle "
"kelattaessa"

#. TRANSLATORS: Option to check for app updates automatically on startup
msgid "Check for &updates on startup"
msgstr "Tarkista &päivitykset käynnistettäessä"

#. TRANSLATORS: Option to automatically reload an open document when its file changes on disk
msgid "&Automatically reload changed documents"
msgstr "&Päivitä muuttuneeet asiakirjat automaattisesti"

#. TRANSLATORS: Button label to open the hotkey customization dialog
msgid "Customize &Window Hotkey..."
msgstr "&Ikkunan pikanäppäin..."

#. TRANSLATORS: Button label to open the Keyboard Shortcuts customization dialog
msgid "Customize &Keyboard Shortcuts..."
msgstr "Muokkaa &pikanäppäimiä..."

#. TRANSLATORS: Label for the reading speed input field (Words Per Minute)
msgid "&Reading speed (words per minute):"
msgstr "&Lukunopeus (sanaa minuutissa):"

#. TRANSLATORS: Label for the number of recently opened documents to keep in history
msgid "Number of &recent documents to show:"
msgstr "V&iimeisimpien asiakirjojen määrä:"

#. TRANSLATORS: Label for the language selection dropdown
msgid "&Language:"
msgstr "&Kieli:"

#. TRANSLATORS: Label for the update channel selection dropdown
msgid "Update Channel:"
msgstr "Päivityskanava:"

#. TRANSLATORS: Stable update channel option
msgid "Stable"
msgstr "Vakaa"

#. TRANSLATORS: Developer/development update channel option
msgid "Dev"
msgstr "Kehitys"

#. TRANSLATORS: Label/header for the Font options section
msgid "Font"
msgstr "Fontti"

#. TRANSLATORS: Button label to pick a font
msgid "Choose &Font..."
msgstr "Valitse &fontti..."

#. TRANSLATORS: Button label to restore font settings to default values
msgid "&Reset to Default Font"
msgstr "&Palauta oletusfontti"

#. TRANSLATORS: Label/header for the Background Color options section
msgid "Background Color"
msgstr "Taustaväri"

#. TRANSLATORS: Button label to pick a background color
msgid "Choose &Background Color..."
msgstr "Valitse ta&ustaväri..."

#. TRANSLATORS: Button label to restore background color to default values
msgid "Reset to &Default Background"
msgstr "Palauta &oletustausta"

#. TRANSLATORS: Label for the line spacing dropdown
msgid "&Line spacing:"
msgstr "R&iviväli:"

#. TRANSLATORS: Default spacing option (as opposed to relaxed/wide), shown in the line, paragraph, and letter spacing dropdowns
msgid "Normal"
msgstr "Normaali"

#. TRANSLATORS: 1.5x line spacing option
msgid "1.5\\u{00d7}"
msgstr "1,5\\u{00d7}"

#. TRANSLATORS: Double line spacing option
msgid "Double"
msgstr "Kaksinkertainen"

#. TRANSLATORS: Label for the paragraph spacing dropdown
msgid "&Paragraph spacing:"
msgstr "&Kappaleväli:"

#. TRANSLATORS: Relaxed paragraph spacing option
msgid "Relaxed"
msgstr "Väljä"

#. TRANSLATORS: Wide spacing option, shown in the paragraph and letter spacing dropdowns
msgid "Wide"
msgstr "Leveä"

#. TRANSLATORS: Label for the letter spacing dropdown
msgid "L&etter spacing:"
msgstr "K&irjainväli:"

#. TRANSLATORS: Very Wide letter spacing option
msgid "Very Wide"
msgstr "Erittäin leveä"

#. TRANSLATORS: Label for the text alignment dropdown
msgid "Text &alignment:"
msgstr "Tekstin t&asaus:"

#. TRANSLATORS: Left text alignment option
msgid "Left"
msgstr "Vasemmalla"

#. TRANSLATORS: Center text alignment option
msgid "Center"
msgstr "Keskellä"

#. TRANSLATORS: Right text alignment option
msgid "Right"
msgstr "Oikealla"

#. TRANSLATORS: Justified text alignment option
msgid "Justify"
msgstr "Molemmissa reunoissa"

#. TRANSLATORS: Tab label for the General options panel
msgid "General"
msgstr "Yleiset"

#. TRANSLATORS: Tab label for the Reading options panel
#. TRANSLATORS: Status bar label for the reading progress percentage, e.g. "Line 5, Character 120, Reading 45%"
msgid "Reading"
msgstr "Lukeminen"

#. TRANSLATORS: Tab label for the Readability options panel
msgid "Readability"
msgstr "Luettavuus"

#. TRANSLATORS: Description text shown when the background color is set to default
msgid "Background: Default"
msgstr "Tausta: Oletus"

#. TRANSLATORS: Description text shown when the font is set to default
msgid "Font: Default"
msgstr "Fontti: Oletus"

#. TRANSLATORS: Fallback font name
msgid "Default"
msgstr "Oletus"

#. TRANSLATORS: Font description prefix; {} is the font face name
msgid "Font: {}"
msgstr "Fontti: {}"

#. TRANSLATORS: Point size attribute; {} is the numeric size, "pt" is the unit abbreviation
msgid "{}pt"
msgstr "{} pistettä"

#. TRANSLATORS: Font weight attribute name
msgid "Bold"
msgstr "Lihavoitu"

#. TRANSLATORS: Font style attribute name
msgid "Italic"
msgstr "Kursivoitu"

#. TRANSLATORS: Font underline attribute name
msgid "Underlined"
msgstr "Alleviivattu"

#. TRANSLATORS: Font strikethrough attribute name
msgid "Strikethrough"
msgstr "Yliviivattu"

#. TRANSLATORS: Title of the hotkey customization dialog
msgid "Window Hotkey"
msgstr "Ikkunan pikanäppäin"

#. TRANSLATORS: Checkbox label for Control modifier key
#. TRANSLATORS: Checkbox in the Set Shortcut dialog that includes the Ctrl modifier in the shortcut.
msgid "&Ctrl"
msgstr "&Ctrl"

#. TRANSLATORS: Checkbox label for Alt modifier key
#. TRANSLATORS: Checkbox in the Set Shortcut dialog that includes the Alt modifier in the shortcut.
msgid "&Alt"
msgstr "&Alt"

#. TRANSLATORS: Checkbox label for Shift modifier key
#. TRANSLATORS: Checkbox in the Set Shortcut dialog that includes the Shift modifier in the shortcut.
msgid "&Shift"
msgstr "&Shift"

#. TRANSLATORS: Checkbox label for Windows modifier key
msgid "&Win"
msgstr "&Win"

#. TRANSLATORS: Label for the hotkey key selection input field
#. TRANSLATORS: Label next to the key field in the Set Shortcut dialog.
msgid "&Key:"
msgstr "&Näppäin:"

#. TRANSLATORS: Button label to clear the current hotkey selection
msgid "Clear"
msgstr "Tyhjennä"

#. TRANSLATORS: Label for the cancellation button
#. TRANSLATORS: Cancel button in the Set Shortcut dialog.
#. TRANSLATORS: Label for the cancellation button
#. TRANSLATORS: Cancel button that closes the Find dialog
#. TRANSLATORS: Label for the cancellation button
msgid "Cancel"
msgstr "Peruuta"

#. TRANSLATORS: Representation of the Spacebar key
msgid "Space"
msgstr "Väli"

#. TRANSLATORS: Title of the Keyboard Shortcuts dialog.
msgid "Customize Keyboard Shortcuts"
msgstr "Muokkaa pikanäppäimiä"

#. TRANSLATORS: Label above the list of shortcuts for a category in the Keyboard Shortcuts dialog.
msgid "&Shortcuts:"
msgstr "&Pikanäppäimet:"

#. TRANSLATORS: Button in the Keyboard Shortcuts dialog that opens a prompt to assign a new shortcut to the selected action.
msgid "&Set Shortcut..."
msgstr "&Määritä pikanäppäin..."

#. TRANSLATORS: Button in the Keyboard Shortcuts dialog that removes the shortcut assigned to the selected action.
msgid "&Clear Shortcut"
msgstr "&Poista pikanäppäin"

#. TRANSLATORS: Button in the Keyboard Shortcuts dialog that restores the selected action's shortcut to its default.
msgid "&Reset to Default"
msgstr "&Palauta oletukset"

#. TRANSLATORS: Button in the Keyboard Shortcuts dialog that restores every action's shortcut to its default.
msgid "Reset &All to Defaults"
msgstr "Palauta &kaikki oletuspikanäppäimet"

#. TRANSLATORS: the three {} are, in order: the key chord, the action it's currently assigned to, and the action being (re)assigned to it
msgid "'{}' is already assigned to '{}'. Reassign it to '{}'?"
msgstr ""
"Pikanäppäin {} on jo määritetty komentoon {}. Haluatko määrittää sen "
"uudelleen komennolle {}?"

#. TRANSLATORS: Title of the dialog warning that a shortcut is already taken
msgid "Shortcut Conflict"
msgstr "Pikanäppäimen ristiriita"

msgid "Reset all shortcuts to their default values?"
msgstr "Palautetaanko oletuspikanäppäimet?"

#. TRANSLATORS: Title of the confirmation dialog for resetting all keyboard shortcuts to their defaults.
msgid "Reset Shortcuts"
msgstr "Oletuspikanäppäinten palautus"

#. TRANSLATORS: Title of the Set Shortcut dialog. The {} placeholder is replaced with the action's display name.
msgid "Set Shortcut for {}"
msgstr "Määritä pikanäppäin komennolle {}"

#. TRANSLATORS: Instruction text in the Set Shortcut dialog. The {} placeholder is replaced with the action's display name.
msgid "Configure shortcut for {}:"
msgstr "Määritä komennon {} pikanäppäin:"

msgid "Tip: click in the key field and press the key combination you want."
msgstr ""
"Vihje: Napsauta näppäimen  muokkauskenttää ja paina haluamaasi "
"näppäinyhdistelmää."

#. TRANSLATORS: Placeholder shown in the Set Shortcut dialog before any key combination has been captured
msgid "Detected: (none)"
msgstr "Havaittu: (ei mitään)"

msgid "Detected: {}"
msgstr "Havaittu: {}"

msgid "No key detected"
msgstr "Näppäinpainallusta ei havaittu"

#. TRANSLATORS: Button in the Set Shortcut dialog that clears the captured key combination.
msgid "&Clear"
msgstr "&Poista"

#. TRANSLATORS: Title of the Sleep Timer dialog
msgid "Sleep Timer"
msgstr "Uniajastin"

#. TRANSLATORS: Label for the input field where users enter the number of minutes for the sleep timer.
msgid "&Minutes:"
msgstr "&Minuuttia:"

#. TRANSLATORS: Title of the Table of Contents dialog
#. TRANSLATORS: Name of this keyboard-shortcut action, shown in the Customize Keyboard Shortcuts dialog (its list of assignable actions, and the "Set Shortcut for {}" / conflict-reassignment prompts).
msgid "Table of Contents"
msgstr "Sisällysluettelo"

#. TRANSLATORS: Error message shown when the user attempts to confirm the Table of Contents dialog without having selected any section
msgid "Please select a section from the table of contents."
msgstr "Valitse luku sisällysluettelosta."

#. TRANSLATORS: Title of the error dialog shown when the user attempts to confirm the Table of Contents dialog without having selected any section
msgid "No Selection"
msgstr "Ei valintaa"

#. TRANSLATORS: Title of the View Note dialog
msgid "View Note"
msgstr "Näytä muistiinpano"

#. TRANSLATORS: Duration segment for hours in the estimated reading time (e.g. "1 hour" / "5 hours"). The %d placeholder is replaced with the count.
msgid "%d hour"
