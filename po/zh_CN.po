msgid "Plain Text"
msgstr "纯文本"

#. TRANSLATORS: Choice option to open a file as HTML
msgid "HTML"
msgstr "HTML"

#. TRANSLATORS: Choice option to open a file as Markdown
msgid "Markdown"
msgstr "Markdown"

#. TRANSLATORS: Title of the Settings dialog
msgid "Settings"
msgstr "设置"

#. TRANSLATORS: Option to restore documents that were open when the app was last closed
msgid "&Restore previously opened documents on startup"
msgstr "启动时恢复上次打开的文档(&R)"

#. TRANSLATORS: Option to toggle word wrapping of text
