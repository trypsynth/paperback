msgid "Please select a bookmark to jump to."
msgstr "请选择要跳转到的书签。"

#. TRANSLATORS: Generic error dialog title
msgid "Error"
msgstr "错误"

#. TRANSLATORS: Title of the Bookmark Note editor dialog
msgid "Bookmark Note"
msgstr "书签笔记"

#. TRANSLATORS: Label/prompt in the Note editor dialog
msgid "Edit bookmark note:"
msgstr "编辑书签笔记:"

#. TRANSLATORS: Title of the Document Info dialog
msgid "Document Info"
msgstr "文档信息"

#. TRANSLATORS: Label for the document's file path
msgid "Path:"
msgstr "路径:"

#. TRANSLATORS: Label for the document's title
msgid "Title:"
msgstr "标题:"

#. TRANSLATORS: Label for the document's author
msgid "Author:"
msgstr "作者:"

#. TRANSLATORS: Label for the number of words in the document
msgid "Words:"
msgstr "字数:"

