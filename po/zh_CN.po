msgid "Invalid CDIC phrase offset"
msgstr "无效的 CDIC 短语偏移"

#. TRANSLATORS: Error shown when a MOBI file's compressed dictionary phrase length is out of bounds
msgid "Invalid CDIC phrase length"
msgstr "无效的 CDIC 短语长度"

