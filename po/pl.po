#. TRANSLATORS: Label for the cancellation button
msgid "Cancel"
msgstr "Anuluj"

#. TRANSLATORS: Representation of the Spacebar key
msgid "Space"
msgstr "Spacja"

msgid "Customize Keyboard Shortcuts"
msgstr "Dostosuj skróty klawiszowe"

msgid "&Shortcuts:"
msgstr "&Skróty:"

