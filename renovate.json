{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "cargo dependencies",
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "windows-core is only here for #[implement] in the UI Automation tests, which has to use the same windows-core the windows crate does. windows is still on 0.62, so raise this ceiling together with windows.",
      "matchPackageNames": ["windows-core"],
      "allowedVersions": "<0.100.0"
    }
  ],
  "customManagers": [
    {
      "description": "Cobalt is installed from a release tarball, so no manager sees it natively.",
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/site.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)\\s+COBALT_VERSION: (?<currentValue>[^\\s]+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "The wxWidgets master commit Paperback builds against, named in WXWIDGETS_DIR so a new one rebuilds wxWidgets.",
      "customType": "regex",
      "managerFilePatterns": [".cargo/config.toml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s+WXWIDGETS_DIR = \\{ value = \"target/wxWidgets-(?<currentDigest>[0-9a-f]{40})\""
      ]
    }
  ]
}
