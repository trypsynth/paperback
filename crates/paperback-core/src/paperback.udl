namespace paperback {
	void set_pdfium_library_path(string path);
};

[Error]
enum DocumentError {
	"ParseError"
};

dictionary TocEntry {
	string title;
	i64 position;
	i32 level;
};

enum MarkerType {
	"Heading1", "Heading2", "Heading3", "Heading4", "Heading5", "Heading6",
	"PageBreak", "SectionBreak", "TocItem", "Link",
	"List", "ListItem", "Table", "Separator", "Image", "Figure",
	"Bold", "Italic", "Underline"
};

dictionary LineMarker {
	MarkerType mtype;
	i64 position;
	string text;
	string reference;
	i32 level;
	i64 length;
};

enum LinkAction {
	"Internal", "External", "NotFound"
};

dictionary LinkActivationResult {
	boolean found;
	LinkAction action;
	i64 offset;
	string url;
};

enum SegmentTypeFfi {
	"Paragraph", "Line",
	"Heading", "Link", "Section", "Page",
	"List", "ListItem", "Table", "Separator",
	"Image", "Figure"
};

enum SegmentDirectionFfi {
	"Current", "Next", "Previous"
};

dictionary TextSegmentFfi {
	string text;
	i64 start_pos;
	i64 end_pos;
};

dictionary DocumentStatsFfi {
	i64 word_count;
	i64 line_count;
	i64 char_count;
	i64 char_count_no_whitespace;
};

dictionary SearchOptionsFfi {
	boolean match_case;
	boolean whole_word;
	boolean regex;
	boolean forward;
};

dictionary SearchResultFfi {
	boolean found;
	boolean wrapped;
	i64 position;
};

dictionary AudioClipFfi {
	boolean found;
	i32 source;
	i64 clip_begin_ms;
	i64 clip_end_ms;
	i64 start;
	i64 end;
};

dictionary AudioCursorFfi {
	boolean found;
	i32 clip_index;
	i64 seek_ms;
};

dictionary AudioPointFfi {
	boolean found;
	i64 position;
	i64 time_ms;
};

dictionary StatusInfo {
	i64 line_number;
	i64 character_number;
	i32 percentage;
};

dictionary HeadingTreeItemFfi {
	i64 offset;
	string text;
	i32 parent_index;
};

dictionary HeadingTreeFfi {
	sequence<HeadingTreeItemFfi> items;
	i32 closest_index;
};

dictionary LinkListItemFfi {
	i64 offset;
	string text;
};

dictionary LinkListFfi {
	sequence<LinkListItemFfi> items;
	i32 closest_index;
};

interface DocumentSession {
	[Name=new_ffi, Throws=DocumentError]
	constructor(string file_path, string password, string forced_extension, boolean render_tables_inline);

	string title();
	string author();
	string content();

	string get_line_text(i64 position);
	i64 line_count();
	i64 position_from_line(i64 line);
	i64 line_from_position(i64 position);
	sequence<LineMarker> get_line_markers(i64 line);
	LinkActivationResult activate_link(i64 position);
	TextSegmentFfi get_text_segment(i64 position, SegmentTypeFfi segment_type, SegmentDirectionFfi direction);

	StatusInfo get_status_info(i64 position);
	i64 position_from_percent(i32 percent);
	i32 current_page(i64 position);
	i32 page_count_ffi();
	i64 page_offset(i32 page);

	HeadingTreeFfi get_heading_tree_ffi(i64 position);
	LinkListFfi get_link_list_ffi(i64 position);

	sequence<TocEntry> get_toc();

	boolean has_audio_ffi();
	boolean is_audio_only_ffi();
	i32 audio_source_count_ffi();
	string audio_source_direct_path_ffi(i32 index);
	boolean audio_extract_source_ffi(i32 index, string output_path);
	i32 audio_clip_count_ffi();
	AudioClipFfi audio_clip_ffi(i32 index);
	i64 audio_total_duration_ms_ffi();
	AudioCursorFfi audio_cursor_at_elapsed_ffi(i64 elapsed_ms);
	AudioPointFfi audio_point_for_position_ffi(i64 position);
	i64 audio_elapsed_for_source_position_ffi(i32 source, i64 raw_ms);
	i32 audio_next_source_after_ffi(i32 current_source);
	i32 audio_previous_source_before_ffi(i32 current_source);

	DocumentStatsFfi get_stats_ffi();
	sequence<SegmentTypeFfi> get_supported_segment_types_ffi();

	SearchResultFfi search_ffi(string query, i64 start_position, SearchOptionsFfi options);

	sequence<ExportFormat> get_supported_export_formats_ffi();
	string render_export_ffi(ExportFormat format);
};

enum ExportFormat {
	"Text",
	"Html",
	"Markdown"
};

interface ConfigManagerFfi {
	constructor();

	boolean initialize(string config_path);
	string get_doc_key(string path);
	string get_app_string(string key, string default_value);
	void set_app_string(string key, string value);
	boolean get_app_bool(string key, boolean default_value);
	void set_app_bool(string key, boolean value);
	i32 get_app_int(string key, i32 default_value);
	void set_app_int(string key, i32 value);
	void associate_uri_with_local_file(string uri, string local_path);
	void set_document_position(string path, i64 position);
	i64 get_document_position(string path);
	void set_document_audio_time_ffi(string path, i64 time_ms);
	i64 get_document_audio_time_ffi(string path);
	void set_document_password(string path, string password);
	string get_document_password(string path);
	void add_recent_document(string path);
	sequence<string> get_recent_documents();
	void add_opened_document(string path);
	void remove_opened_document(string path);
	void set_document_opened(string path, boolean opened);
	sequence<string> get_opened_documents();
	void remove_document_history(string path);
	void rename_document_path(string old_path, string new_path);
	sequence<string> get_supported_extensions();
	sequence<string> get_find_history();
	void add_find_history(string text, i32 max_len);
	void import_document_settings(string path);
	void import_settings_from_file(string doc_path, string import_path);
	void export_document_settings(string doc_path, string export_path);
	void flush();
};
